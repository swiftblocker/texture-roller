    {"id": "R25b", "metric": "raised_fraction", "op": ">", "value": 0.80, "action": "WARN", "msg": "Image is mostly background"},
    {"id": "R29", "metric": "n_around is integer >= 1", "op": "==", "value": false, "action": "BLOCK", "msg": "Repeat around must be a whole number"},
