    {"id": "R16", "metric": "d / D", "op": ">", "value": 0.12, "action": "WARN", "msg": "Relief deep for this diameter"},
    {"id": "R19a", "metric": "min_raised_width", "op": "<", "value": 1.0, "action": "WARN", "msg": "Raised feature thinner than 1.0 mm"},
