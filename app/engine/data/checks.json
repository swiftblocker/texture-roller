    {"id": "R32", "metric": "offset != 0 and n_around == 1", "op": "==", "value": true, "action": "BLOCK", "msg": "Offset needs 2 or more repeats around"},
    {"id": "R38a", "metric": "seam_edge_diff", "op": ">", "value": 0.05, "action": "WARN", "msg": "Seam step over 0.05 mm"},
